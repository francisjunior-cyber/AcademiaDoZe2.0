<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardListPage"
             Title="Dashboard">

    <!-- Único elemento raiz permitido dentro do ContentPage -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="25" HorizontalOptions="FillAndExpand">

            <!-- Logotipo e Título -->
            <Image Source="academiadoze.png" 
                   HeightRequest="150" 
                   HorizontalOptions="Center" />

            <Label Text="Academia do Zé" 
                   FontSize="32" 
                   TextColor="#1e1e24" 
                   HorizontalOptions="Center" 
                   Margin="0,0,0,20"/>

            <!-- Grid contendo os 4 Cards alinhados lado a lado -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="15">

                <!-- Card Logradouros -->
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#E1DFF5" StrokeShape="RoundRectangle 12" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding TotalLogradouros}" FontSize="28" TextColor="#333333" HorizontalOptions="Center" />
                        <Label Text="Logradouros" TextColor="#555555" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Card Alunos -->
                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#E1DFF5" StrokeShape="RoundRectangle 12" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding TotalAlunos}" FontSize="28" TextColor="#333333" HorizontalOptions="Center" />
                        <Label Text="Alunos" TextColor="#555555" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Card Colaboradores -->
                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#E1DFF5" StrokeShape="RoundRectangle 12" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding TotalColaboradores}" FontSize="28" TextColor="#333333" HorizontalOptions="Center" />
                        <Label Text="Colaboradores" TextColor="#555555" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Card Matrículas -->
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#E1DFF5" StrokeShape="RoundRectangle 12" Padding="20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding TotalMatriculas}" FontSize="28" TextColor="#333333" HorizontalOptions="Center" />
                        <Label Text="Matrículas" TextColor="#555555" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>