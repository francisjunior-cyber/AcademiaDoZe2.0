<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.LogradouroPage"
             xmlns:vm="clr-namespace:AcademiaDoZe.Presentation.AppMaui.ViewModels"
             x:DataType="vm:LogradouroViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <StackLayout Spacing="15" Padding="20">
            <Entry Text="{Binding Logradouro.Cep}" Placeholder="CEP"/>
            <Entry Text="{Binding Logradouro.Nome}" Placeholder="Nome / Rua"/>
            <Entry Text="{Binding Logradouro.Bairro}" Placeholder="Bairro"/>
            <Entry Text="{Binding Logradouro.Cidade}" Placeholder="Cidade"/>
            <Entry Text="{Binding Logradouro.Estado}" Placeholder="UF"/>
            <Entry Text="{Binding Logradouro.Pais}" Placeholder="País"/>
            <Button Text="Salvar" Command="{Binding SaveLogradouroCommand}" Style="{StaticResource ButtonPrimary}"/>
            <Button Text="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource ButtonSecondary}"/>
        </StackLayout>
    </ScrollView>
</ContentPage>